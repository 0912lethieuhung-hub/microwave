# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DÀNH CHO RENDER (RENDER ENVIRONMENT VARIABLES)
# Dự án: Siêu Lò Nướng Microwave
# ==============================================================================

# 1. Ứng dụng Laravel
APP_NAME="Microwave Store"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com
APP_KEY=base64:THAY_BANG_APP_KEY_PRODUCTION
TRUSTED_PROXIES=*

# 2. Cơ sở dữ liệu MySQL trên Aiven (Kèm SSL)
DB_CONNECTION=mysql
DB_HOST=YOUR-AIVEN-HOST.aivencloud.com
DB_PORT=YOUR-AIVEN-PORT
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=THAY_BANG_MAT_KHAU_AIVEN
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

# 3. Session & Cache
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info

# 4. Cấu hình Khởi động & Triển khai Container
PORT=10000
RUN_MIGRATIONS=true
RUN_SEEDERS=false

# 5. Khởi tạo tài khoản Quản trị viên (Chỉ bật RUN_SEEDERS=true ở lần deploy đầu)
# Lưu ý: Mật khẩu bắt buộc từ 12 ký tự trở lên
SEED_ADMIN_NAME="Shop Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ThayBangMatKhauBaoMat12KyTu!

# 6. Tích hợp Thanh toán MoMo & Vận chuyển GHN (Production URLs)
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=klm05TvNBzhg7h7j
MOMO_SECRET_KEY=at67qH6mk8w5Y1nAyMoYKMWACiEi2bsa
MOMO_REDIRECT_URL=https://YOUR-SERVICE.onrender.com/payment/momo/callback
MOMO_IPN_URL=https://YOUR-SERVICE.onrender.com/payment/momo/ipn
MOMO_VERIFY_SSL=true
GHN_VERIFY_SSL=true

# 7. Cấu hình Mail (Mặc định ghi log vào stderr container)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Microwave Store"
